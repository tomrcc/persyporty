---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Markdown from "../utility/markdown.astro";

interface Props {
  background_color: string;
  text_color: string;
  heading: string;
  text_content: string;
  image: {
    image_path: string;
    image_alt: string;
  };
  flipped: boolean;
  block_id: string;
}

const { heading, text_content, image, flipped, block_id } = Astro.props;
---

<section id={block_id}>
  <div class="content">
    {
      flipped && (
        <div class="image">
          <img src={image.image_path} alt={image.image_alt} />
        </div>
      )
    }
    <div class="text">
      <h2>{heading}</h2>
      <Markdown content={text_content} />
    </div>
    {
      !flipped && (
        <div class="image">
          <img src={image.image_path} alt={image.image_alt} />
        </div>
      )
    }
  </div>
</section>

<style>
  section {
    padding-block: 96px;
    background-color: var(--bg-color);
    color: var(--text-color);
  }
  .content {
    max-width: var(--pageContainer);
    padding-inline: var(--pagePadding);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .text {
    width: 100%;
  }

  h2 {
    font-size: clamp(3rem, 15vw, 7.75rem);
    line-height: clamp(3rem, 13vw, 6.75rem);
    font-weight: 400;
    margin-bottom: 3rem;
    text-wrap: balance;
  }
  .image {
    width: 100%;
    max-width: 420px;
    display: flex;
    align-items: center;
    justify-content: center;
    align-self: center;
  }
  .image img {
    border-radius: 100%;
  }
  .text p {
    max-width: 72ch;
    font-weight: 200;
    margin-block: 1rem;
    font-size: 16px;
    line-height: 34px;
    letter-spacing: 0.1em;
  }

  @media screen and (min-width: 720px) {
    .content {
      display: flex;
      flex-direction: row;
      justify-content: space-between;
      gap: 1rem;
    }

    .text {
      width: 50%;
    }

    .image {
      width: 50%;
    }
  }
</style>
