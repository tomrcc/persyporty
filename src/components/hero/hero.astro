---
import Icon from "../utility/icon";

interface Props {
  text_color: string;
  background_color: string;
  heading: string;
  subheading: string;
}

const { heading, subheading } = Astro.props;
---

<section>
  <div class="hero-container">
    <h1>{heading}</h1>
    <p class="subheading">{subheading}</p>
  </div>
</section>

<style>
  section {
    background-color: var(--bg-color);
    color: var(--text-color);
    max-width: var(--pageContainer);
    padding-inline: var(--pagePadding);
    margin: 0 auto;
    padding-top: 96px;
    padding-bottom: 96px;
    font-family: "Playfair Display", serif;
    display: flex;
    align-items: center;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    justify-content: center;
    overflow-x: hidden;
  }
  h1 {
    font-size: clamp(2rem, 14vw, 10rem);
    line-height: clamp(2rem, 14vw, 10rem);
    font-weight: 400;
    display: flex;
    flex-direction: column;
    overflow-y: hidden;
    color: inherit;
  }
  .subheading {
    margin-top: 64px;
    align-self: end;
    display: flex;
    gap: 0.1rem;
    margin-inline: 0;
    font-size: clamp(1.25rem, 8vw, 4rem);
    font-weight: 300;
  }

  @media screen and (min-width: 720px) and (max-width: 2560px) {
    section {
      min-height: 100vh;
    }
  }
</style>
